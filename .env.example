# ── Language model ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Not needed for Ollama. For a cloud provider put your key here (never commit .env).
LLM_API_KEY=
# "openai" = real model via the URL above, "mock" = rule-based stand-in for offline testing
LLM_PROVIDER=openai

# ── Security ───────────────────────────────────────────────────
# Secret used to sign confirmation tokens. Change it to any long random string.
CONFIRM_SECRET=change-me-to-a-long-random-string
# Demo PIN used on the confirmation screen (stands in for Face ID)
DEMO_PIN=2468
# 1 = the app simulates Face ID on the confirmation screen (sandbox). 0 = PIN only.
DEMO_BIOMETRIC=1

# ── FX rates ───────────────────────────────────────────────────
# 1 = fetch live mid-market rates from open.er-api.com (falls back to sample rates offline)
FX_LIVE=0
