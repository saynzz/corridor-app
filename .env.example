# ── Language model ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Not needed for Ollama. For a cloud provider put your key here (never commit .env).
LLM_API_KEY=
# "openai" = real model via the URL above, "mock" = rule-based stand-in for offline testing
LLM_PROVIDER=openai
# Per-call timeout. If the model is down or too slow, the agent answers in simplified (read-only) mode.
LLM_TIMEOUT_MS=60000

# ── Security ───────────────────────────────────────────────────
# Secrets used to sign confirmation tokens and role sessions. Change both to long random strings.
CONFIRM_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
# Student PIN (confirmation screen and tuition approval)
DEMO_PIN=2468
# Family payer (Budi) PIN — different from the student's
PAYER_PIN=1357
# Operator console key. Change it for any shared deployment.
OPERATOR_KEY=ops-demo-2026
# 0 hides the sandbox credential hints in the sign-in form
DEMO_HINTS=1
# 1 = the app simulates Face ID on the confirmation screen (sandbox). 0 = PIN only.
DEMO_BIOMETRIC=1

# ── FX rates ───────────────────────────────────────────────────
# 1 (default) = live mid-market rates from open.er-api.com, falls back to sample rates offline. 0 = sample only.
FX_LIVE=1

# ── Audit anchoring ────────────────────────────────────────────
# local = hash-chained ledger file (simulation). webase = FISCO BCOS through WeBASE-Front.
ANCHOR_PROVIDER=local
WEBASE_URL=http://127.0.0.1:5002
FISCO_GROUP=group0
ANCHOR_CONTRACT=
ANCHOR_SIGN_USER=
